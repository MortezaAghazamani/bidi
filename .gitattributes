# Default: text, LF line endings
* text=auto eol=lf

# Source code
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.c text eol=lf
*.cc text eol=lf
*.inc text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf
*.rst text eol=lf

# CMake
CMakeLists.txt text eol=lf
*.cmake text eol=lf
*.cmake.in text eol=lf
Doxyfile.in text eol=lf

# JSON
*.json text eol=lf

# YAML
*.yml text eol=lf
*.yaml text eol=lf

# PowerShell (Windows line endings)
*.ps1 text eol=crlf

# Visual Studio
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf
